# Copy to config/.env and change every value before deploying.
# Quote values that contain "#", spaces or quotes.

# --- Postgres (rooms) ---
ROOMS_DB_PASSWORD='change-me-rooms-db'

# --- JWT (use long random strings: openssl rand -hex 32) ---
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- APISIX admin API key (openssl rand -hex 16) ---
APISIX_ADMIN_KEY=change-me-apisix-admin-key

# --- LiveKit (secret must be at least 32 characters) ---
LIVEKIT_API_KEY=conferx
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-chars
# URL browsers use to reach LiveKit. Use wss://<domain> in production.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IP advertised to browsers for media. 127.0.0.1 for local dev, public IP in production.
LIVEKIT_NODE_IP=127.0.0.1

# --- Frontend origin(s), comma separated ---
CORS_ORIGIN=http://localhost:3000
# Set to false only when serving over plain http on a non-localhost host
COOKIE_SECURE=true
